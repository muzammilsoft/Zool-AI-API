<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f4f4; margin: 0; padding: 20px; }
        .container { max-width: 1200px; margin: auto; padding: 20px; border-radius: 8px; background: #fff; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #eee; padding-bottom: 10px; margin-bottom: 20px; }
        .logout-btn { background-color: #6c757d; color: white; text-decoration: none; padding: 8px 15px; border-radius: 4px; font-size: 14px; }
        h1 { color: #333; margin: 0; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ddd; padding: 12px; text-align: right; }
        th { background-color: #f2f2f2; color: #333; }
        .status-active { color: #28a745; font-weight: bold; }
        .status-inactive { color: #dc3545; font-weight: bold; }
        .form-section { margin-top: 40px; border-top: 2px solid #ddd; padding-top: 20px; }
        .form-group { margin-bottom: 10px; }
        label { display: block; margin-bottom: 5px; }
        input, select { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
        button { background-color: #007bff; color: white; padding: 10px 15px; border: none; border-radius: 4px; cursor: pointer; }
        .usage-badge { background-color: #e9ecef; padding: 3px 8px; border-radius: 12px; font-size: 0.85em; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>لوحة التحكم - Zool-AI API</h1>
            <div>
                <span>مرحباً، <%= adminEmail %></span>
                <a href="/admin/logout" class="logout-btn" style="margin-right: 10px;">تسجيل خروج</a>
            </div>
        </div>

        <div class="form-section">
            <h2>إعدادات الحساب</h2>
            <form action="/admin/profile" method="POST" style="display: flex; gap: 10px; align-items: flex-end;">
                <div class="form-group" style="flex: 1;">
                    <label>البريد الإلكتروني:</label>
                    <input type="email" name="email" value="<%= adminEmail %>" required>
                </div>
                <div class="form-group" style="flex: 1;">
                    <label>كلمة المرور الجديدة (اتركها فارغة للحفاظ على الحالية):</label>
                    <input type="password" name="password" placeholder="••••••••">
                </div>
                <button type="submit" style="height: 40px; margin-bottom: 10px;">تحديث البروفايل</button>
            </form>
        </div>

        <h2>المفاتيح الحالية والإحصائيات</h2>
        <table>
            <thead>
                <tr>
                    <th>المفتاح</th>
                    <th>الاسم والبريد</th>
                    <th>النوع</th>
                    <th>الطلبات</th>
                    <th>التوكنز</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                <% keys.forEach(function(key) { %>
                    <tr>
                        <td><code><%= key.key %></code></td>
                        <td>
                            <strong><%= key.first_name %> <%= key.last_name %></strong><br>
                            <small><%= key.email %></small>
                        </td>
                        <td><%= key.type %></td>
                        <td><span class="usage-badge"><%= key.total_requests || 0 %></span></td>
                        <td><span class="usage-badge"><%= key.total_tokens || 0 %></span></td>
                        <td class="status-<%= key.status %>"><%= key.status %></td>
                        <td>
                            <form action="/admin/toggle-key" method="POST" style="display:inline;">
                                <input type="hidden" name="id" value="<%= key.id %>">
                                <input type="hidden" name="status" value="<%= key.status === 'active' ? 'inactive' : 'active' %>">
                                <button type="submit" style="background-color: <%= key.status === 'active' ? '#dc3545' : '#28a745' %>;">
                                    <%= key.status === 'active' ? 'تعطيل' : 'تفعيل' %>
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>

        <div class="form-section">
            <h2>إنشاء مفتاح جديد</h2>
            <form action="/admin/create-key" method="POST" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px;">
                <div class="form-group">
                    <label>الاسم الأول:</label>
                    <input type="text" name="first_name" required>
                </div>
                <div class="form-group">
                    <label>اسم العائلة:</label>
                    <input type="text" name="last_name" required>
                </div>
                <div class="form-group">
                    <label>البريد الإلكتروني:</label>
                    <input type="email" name="email" required>
                </div>
                <div class="form-group">
                    <label>النوع:</label>
                    <select name="type">
                        <option value="standard">Standard</option>
                        <option value="premium">Premium</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>حد الدردشة:</label>
                    <input type="number" name="limit_chat" value="1000">
                </div>
                <div class="form-group">
                    <label>حد الصور:</label>
                    <input type="number" name="limit_image" value="100">
                </div>
                <div style="grid-column: span 3; text-align: left;">
                    <button type="submit" style="width: 200px;">إنشاء المفتاح</button>
                </div>
            </form>
        </div>

        <div class="form-section">
            <h2>طلبات المطورين المعلقة</h2>
            <table>
                <thead>
                    <tr>
                        <th>الاسم</th>
                        <th>البريد</th>
                        <th>الشركة</th>
                        <th>السبب</th>
                        <th>التاريخ</th>
                    </tr>
                </thead>
                <tbody>
                    <% requests.forEach(function(req) { %>
                        <tr>
                            <td><%= req.first_name %> <%= req.last_name %></td>
                            <td><%= req.email %></td>
                            <td><%= req.company %></td>
                            <td><%= req.reason %></td>
                            <td><%= new Date(req.created_at).toLocaleString('ar-EG') %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
