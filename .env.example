PORT=3000
# Pollinations API Key - Get one from pollinations.ai
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# For session persistence, use a Redis provider like Upstash
REDIS_URL=redis://localhost:6379

# Used for admin dashboard session
SESSION_SECRET=a_very_secret_key_here

# Admin Credentials (used for first initialization)
ADMIN_EMAIL=kgsoft@zoolai.com
ADMIN_PASSWORD=kgsoft@zoolai

# Absolute key for testing or developer access
ABSOLUTE_KEY=zoolai_sk_ABS0LUTEKEY

# Mail Config (for developer registration notifications)
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=zoolai_api@proton.me
SMTP_PASS=your_email_password
SMTP_FROM=zoolai_api@proton.me
SMTP_TO=zoolai_api@proton.me
